# Salin menjadi .env.local. Jangan pernah memasukkan berkas .env ke repositori (PRD §15).

# Alamat kanonik situs induk. Dipakai untuk metadata, sitemap, dan JSON-LD.
NEXT_PUBLIC_SITE_URL=https://wadimubarak.com

# --- Mode pratinjau ---
# Selama isi situs masih data contoh, isi dengan 1: perayap mesin pencari
# ditolak seluruhnya (robots.txt dan metadata `robots`).
# Kosongkan atau hapus baris ini setelah data Tier 1 diganti data resmi
# (rekening bank, nomor legalitas, nama pengurus, kontak).
NEXT_PUBLIC_MODE_PRATINJAU=1

# --- WordPress headless (sumber angka donasi) ---
# Kosong = situs memakai data statis di src/data/donasi.ts. Itu mode yang
# dipakai pratinjau Cloudflare, yang memang tidak punya WordPress di sebelahnya.
# Diisi = program donasi dibaca dari WordPress lewat WPGraphQL.
#
# Di cPanel yang sama, pakai alamat lokal: lebih cepat dan tidak keluar jaringan.
# WPGRAPHQL_ENDPOINT=http://127.0.0.1/graphql
# WPGRAPHQL_ENDPOINT=https://cms.wadimubarak.com/graphql
#
# Hanya perlu bila program donasi diset non-publik di WordPress.
# WPGRAPHQL_TOKEN=
#
# --- WordPress: berita & artikel ---
# Kosong = /informasi memakai tulisan contoh di src/data/posts.ts.
# Diisi = berita dibaca dari REST API WordPress (bukan WPGraphQL, instalasi
# yayasan tidak memasangnya). Tunjuk ke akar wp-json, tanpa garis miring akhir.
#
# WP_REST_ENDPOINT=https://wadimubarak.com/wp-json
#
# Kurasi mana tulisan yang naik ke situs induk diatur lewat daftar kategori di
# src/lib/wp-berita.ts (KATEGORI_INDUK), bukan lewat variabel lingkungan.

# Rahasia bersama untuk POST /api/revalidate. Nilainya HARUS sama dengan
# WM_NEXT_REVALIDATE_SECRET di wp-config.php. Bangkitkan dengan:
#   openssl rand -hex 32
# Kosong = /api/revalidate menolak semua permintaan (situs tetap jalan, angka
# menyusul lewat ISR 15 menit).
# REVALIDATE_SECRET=

# --- Formulir kontak (PRD §6) ---
# Tanpa kedua nilai ini, pesan hanya dicatat di log server dan pengunjung
# menerima balasan yang jujur bahwa surel otomatis belum aktif. Alamat tujuan
# tidak diatur di sini: selalu `site.kontak.email` (psbwadimubarak@gmail.com).
RESEND_API_KEY=
KONTAK_EMAIL_PENGIRIM=situs@wadimubarak.com

# --- Analitik (PRD §6, disiapkan Fase 1) ---
# NEXT_PUBLIC_GA_ID=
